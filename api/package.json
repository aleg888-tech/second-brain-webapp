{
  "name": "@brain/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API per la knowledge base: operazioni sui file, ricerca, storico e metadati. Nessun codice AI e nessuna richiesta verso Internet.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@brain/kb-core": "*",
    "@brain/shared": "*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
